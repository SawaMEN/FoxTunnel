{
  "schema": 1,
  "product": "protocol-core",
  "protocol_draft": "vetroff-draft-0",
  "interfaces": {
    "process": {
      "executable": "vetroff",
      "client": "SOCKS5",
      "server": "HTTPS",
      "metadata": [
        "version",
        "--json"
      ],
      "shutdown": "SIGTERM",
      "reload": "SIGHUP (Unix: certificates and access policy)",
      "event_schema": 1,
      "events_flag": "--events-json",
      "event_encoding": "JSON Lines on stdout; diagnostics on stderr",
      "events": [
        "ready",
        "stopped"
      ],
      "portable_shutdown": "--shutdown-on-stdin-eof (host owns stdin pipe)",
      "readiness": "local listeners bound; no remote trust/authentication claim"
    },
    "go": {
      "module": "github.com/SawaMEN/VetroffProxy",
      "api": "experimental; pin a release or commit",
      "sdk_schema": 1
    }
  },
  "host_owns": [
    "vpn-permission",
    "tun",
    "routing",
    "dns",
    "kill-switch",
    "ui",
    "process-supervision"
  ],
  "native_bindings": []
}
