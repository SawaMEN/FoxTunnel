+void Http3StreamTunnel::CloseSendingSide() {
+  MOZ_ASSERT(OnSocketThread());
+  if (mClosed || !mSession || mSendState == SEND_DONE) {
+    return;
+  }
+  mSendState = SEND_DONE;
+  mSession->CloseSendingSide(mStreamId);
+  HasDataToWrite();
+  if (Done()) {
+    CleanupStream(NS_OK);
+  }
+}
