 NS_IMETHODIMP
 Http3TransportLayer::Close(nsresult aReason) {
+  // nsITransport is exposed to the main-thread XPConnect handoff consumer.
+  // Session/stream teardown must run on the socket thread, including errors.
+  if (!OnSocketThread()) {
+    if (!gSocketTransportService) {
+      return NS_ERROR_NOT_AVAILABLE;
+    }
+    RefPtr<Http3TransportLayer> self(this);
+    return gSocketTransportService->Dispatch(
+        NS_NewRunnableFunction("Http3TransportLayer::Close",
+            [self = std::move(self), aReason]() { self->Close(aReason); }),
+        NS_DISPATCH_NORMAL);
+  }
+
   LOG(("Http3TransportLayer::Close [this=%p reason=%" PRIx32 "]\n", this,
        static_cast<uint32_t>(aReason)));
   if (NS_SUCCEEDED(mCondition)) {
