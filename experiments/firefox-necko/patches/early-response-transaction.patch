     requestBody = requestBodyClone;
@@ -2773,6 +2788,13 @@
   }
 
   mDidContentStart = true;
+  // Headers are fully parsed and native HTTP retry/reset decisions have run.
+  // The response pipe may still be empty, so its normal AsyncWait cannot wake
