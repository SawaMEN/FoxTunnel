+nsresult nsInputStreamPump::StartOnHeadersAvailable() {
+  RecursiveMutexAutoLock lock(mMutex);
+  AssertOnThread();
+  if (mState != STATE_START) {
+    return NS_OK;
+  }
+  mStartOnHeadersAvailable = true;
+  // Replace the pipe's body-data wait with a one-time start notification.
+  // If suspended, Resume will arm it; no listener callback bypasses suspension.
+  nsresult rv = mAsyncStream->AsyncWait(nullptr, 0, 0, nullptr);
+  NS_ENSURE_SUCCESS(rv, rv);
+  mWaitingForInputStreamReady = false;
+  return mSuspendCount ? NS_OK : EnsureWaiting();
+}
