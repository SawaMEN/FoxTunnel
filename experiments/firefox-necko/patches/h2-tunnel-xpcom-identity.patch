+void Http2StreamTunnel::CloseSendStream() {
+  MOZ_ASSERT(OnSocketThread());
+  if (mSendClosed || mClosed) {
+    return;
+  }
+  mSendClosed = true;
+  RefPtr<Http2Session> session = Session();
+  if (session) {
+    session->TransactionHasDataToWrite(this);
+  }
+}
+
+// Response EOF closes the receive side, not an established CONNECT upload.
+// Preserve the base's buffered-data deferral before notifying the consumer.
+bool Http2StreamTunnel::DeferCleanup(nsresult aStatus) {
+  if (Http2StreamBase::DeferCleanup(aStatus)) {
+    return true;
+  }
+  if (NS_SUCCEEDED(aStatus) && mTunnelEstablished && RecvdFin() &&
+      mUpstreamState != UPSTREAM_COMPLETE) {
+    (void)mInput->OnSocketReady(NS_BASE_STREAM_CLOSED);
+    return true;
+  }
+  return false;
+}
+
+nsresult Http2StreamTunnel::ReadSegments(nsAHttpSegmentReader* aReader,
+                                       uint32_t aCount, uint32_t* aCountRead) {
+  nsresult rv = Http2StreamBase::ReadSegments(aReader, aCount, aCountRead);
+  // The final request frame has reached the session output queue. Only now
+  // can a response-first tunnel leave the session's stream tables.
+  if (NS_SUCCEEDED(rv) && mUpstreamState == UPSTREAM_COMPLETE && RecvdFin() &&
+      !DataBuffered()) {
+    RefPtr<Http2Session> session = Session();
+    if (session) {
+      session->CleanupStream(this, NS_OK, Http2Session::CANCEL_ERROR);
+    }
+  }
+  return rv;
+}
