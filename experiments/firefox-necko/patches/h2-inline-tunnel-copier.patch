+// H2 tunnel I/O is pull-driven: Read/Write are valid only while its native
+// readiness callback is on the stack. NS_AsyncCopy posts a continuation, so
+// it loses that context and repeatedly gets WOULD_BLOCK. Keep the JS-facing
+// pipes, but copy synchronously inside native readiness callbacks on STS.
+// One bounded buffer per direction retains bytes across partial writes.
+class InlineTunnelCopier final : public nsIInputStreamCallback,
+                                 public nsIOutputStreamCallback {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+
+  InlineTunnelCopier(nsIAsyncInputStream* aSource,
+                    nsIAsyncOutputStream* aDestination)
+      : mSource(aSource), mDestination(aDestination) {}
+
+  nsresult Pump() {
+    MOZ_ASSERT(OnSocketThread());
+    if (mFinished) {
+      return NS_OK;
+    }
+    // Limit work per callback; do not starve other streams on the session.
+    for (uint32_t attempt = 0; attempt < 16; ++attempt) {
+      nsresult rv;
+      uint32_t count = 0;
+      if (mOffset != mLength) {
+        rv = mDestination->Write(mBuffer.data() + mOffset, mLength - mOffset,
+                                 &count);
+        if (rv == NS_BASE_STREAM_WOULD_BLOCK) {
+          rv = mDestination->AsyncWait(this, 0, 0, gSocketTransportService);
+          if (NS_FAILED(rv)) {
+            Finish(rv);
+          }
+          return rv;
+        }
+        if (NS_FAILED(rv) || !count) {
+          rv = NS_FAILED(rv) ? rv : NS_ERROR_UNEXPECTED;
+          Finish(rv);
+          return rv;
+        }
+        mOffset += count;
+      } else {
+        mOffset = mLength = 0;
+        rv = mSource->Read(mBuffer.data(), mBuffer.size(), &count);
+        if (rv == NS_BASE_STREAM_WOULD_BLOCK) {
+          rv = mSource->AsyncWait(this, 0, 0, gSocketTransportService);
+          if (NS_FAILED(rv)) {
+            Finish(rv);
+          }
+          return rv;
+        }
+        if (rv == NS_BASE_STREAM_CLOSED || (NS_SUCCEEDED(rv) && !count)) {
+          Finish(NS_OK);
+          return NS_OK;
+        }
+        if (NS_FAILED(rv)) {
+          Finish(rv);
+          return rv;
+        }
+        mLength = count;
+      }
+    }
+    RefPtr<InlineTunnelCopier> self(this);
+    nsresult rv = DispatchToCurrent(NS_NewRunnableFunction(
+        "InlineTunnelCopier::Continue", [self] { Unused << self->Pump(); }));
+    if (NS_FAILED(rv)) {
+      Finish(rv);
+    }
+    return rv;
+  }
+
+  NS_IMETHOD OnInputStreamReady(nsIAsyncInputStream*) override { return Pump(); }
+  NS_IMETHOD OnOutputStreamReady(nsIAsyncOutputStream*) override { return Pump(); }
+
+ private:
+  ~InlineTunnelCopier() = default;
+
+  void Finish(nsresult aReason) {
+    if (mFinished) {
+      return;
+    }
+    mFinished = true;
+    Unused << mSource->AsyncWait(nullptr, 0, 0, gSocketTransportService);
+    Unused << mDestination->AsyncWait(nullptr, 0, 0, gSocketTransportService);
+    nsresult reason = NS_SUCCEEDED(aReason) ? NS_BASE_STREAM_CLOSED : aReason;
+    Unused << mSource->CloseWithStatus(reason);
+    Unused << mDestination->CloseWithStatus(reason);
+    mSource = nullptr;
+    mDestination = nullptr;
+  }
+
+  nsCOMPtr<nsIAsyncInputStream> mSource;
+  nsCOMPtr<nsIAsyncOutputStream> mDestination;
+  std::array<char, 16384> mBuffer;
+  uint32_t mOffset{0};
+  uint32_t mLength{0};
+  bool mFinished{false};
+};
+
+NS_IMPL_ISUPPORTS(InlineTunnelCopier, nsIInputStreamCallback,
+                  nsIOutputStreamCallback)
+
+static nsresult CopyInlineTunnel(nsIAsyncInputStream* aSource,
+                                nsIAsyncOutputStream* aDestination) {
+  RefPtr<InlineTunnelCopier> copier =
+      new InlineTunnelCopier(aSource, aDestination);
+  return copier->Pump();
+}
