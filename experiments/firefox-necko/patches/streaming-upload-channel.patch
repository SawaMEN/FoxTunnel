+
+NS_IMETHODIMP
+HttpBaseChannel::GetDeliverResponseHeadersEarly(bool* aValue) {
+  NS_ENSURE_ARG_POINTER(aValue);
+  *aValue = LoadDeliverResponseHeadersEarly();
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+HttpBaseChannel::SetDeliverResponseHeadersEarly(bool aValue) {
+  NS_ENSURE_TRUE(NS_IsMainThread(), NS_ERROR_NOT_SAME_THREAD);
+  NS_ENSURE_TRUE(XRE_IsParentProcess(), NS_ERROR_NOT_IMPLEMENTED);
+  NS_ENSURE_TRUE(!LoadWasOpened(), NS_ERROR_IN_PROGRESS);
+  StoreDeliverResponseHeadersEarly(aValue);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+HttpBaseChannel::EnableStreamingUpload() {
+  // Async pipes must bypass NormalizeUploadStream, which waits for EOF before
+  // opening the request. Reuse the native Fetch streaming path instead.
+  NS_ENSURE_TRUE(NS_IsMainThread(), NS_ERROR_NOT_SAME_THREAD);
+  NS_ENSURE_TRUE(!LoadWasOpened() && !mUploadStream, NS_ERROR_IN_PROGRESS);
+  StoreUploadStreamIsStreaming(true);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+HttpBaseChannel::ForceHTTP3() {
+  NS_ENSURE_TRUE(NS_IsMainThread() && XRE_IsParentProcess(),
+                 NS_ERROR_NOT_AVAILABLE);
+  NS_ENSURE_TRUE(!LoadWasOpened() && !mConnectionInfo,
+                 NS_ERROR_IN_PROGRESS);
+  NS_ENSURE_TRUE(mURI && mURI->SchemeIs("https"), NS_ERROR_INVALID_ARG);
+  NS_ENSURE_TRUE(gHttpHandler->IsHttp3Enabled(), NS_ERROR_NOT_AVAILABLE);
+  nsAutoCString host;
+  int32_t port = -1;
+  nsresult rv = mURI->GetAsciiHost(host);
+  NS_ENSURE_SUCCESS(rv, rv);
+  rv = mURI->GetPort(&port);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (port == -1) {
+    port = NS_HTTPS_DEFAULT_PORT;
+  }
+  // Preserve URI hostname and NSS verification. This changes protocol intent,
+  // never the destination, trust roots, certificate policy or server identity.
+  mConnectionInfo = new nsHttpConnectionInfo(
+      host, port, "h3"_ns, EmptyCString(), nullptr,
+      mLoadInfo->GetOriginAttributes(), true, true);
+  mConnectionInfo = mConnectionInfo->Mutate()
+                        .SetHttp3Policy(Http3Policy::Only)
+                        .SetNoSpdy(true)
+                        .Finalize();
+  StoreAllowHttp3(true);
+  StoreAllowAltSvc(false);
+  StoreBypassProxy(true);
+  mCaps |= NS_HTTP_DISALLOW_SPDY;
+  return NS_OK;
+}
 
